CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux4Way(in=load, sel=address[13..14],
        a=loadRAM,
        b=loadRAM2,
        c=loadScreen,
        d=loadKeyboard);

    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    RAM16K(in=in, load=loadRAM2, address=address[0..13], out=ramOut2);

    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    Keyboard(out=keyboardOut);

    Mux4Way16(
        a=ramOut,
        b=ramOut2,
        c=screenOut,
        d=keyboardOut,
        sel=address[13..14],
        out=out);
}