CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
     Inc16(in=pcOut, out=incOut);

    Mux16(a=pcOut, b=incOut, sel=inc, out=incResult);
    Mux16(a=incResult, b=in, sel=load, out=loadResult);
    Mux16(a=loadResult, b=false, sel=reset, out=resetResult);

    Register(in=resetResult, load=true, out=pcOut);

    Or16(a=pcOut, b=false, out=out);
}